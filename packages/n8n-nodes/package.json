{
  "name": "@plokkke/n8n-nodes-dougs",
  "version": "1.1.0",
  "description": "n8n community node for Dougs: record expenses and mileage allowances, validate operations, upload invoices.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "dougs",
    "accounting"
  ],
  "author": {
    "name": "Antoine Caron",
    "email": "antoine@crn-tech.fr"
  },
  "license": "MIT",
  "homepage": "https://github.com/Plokkke/dougs-compta/tree/main/packages/n8n-nodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plokkke/dougs-compta.git",
    "directory": "packages/n8n-nodes"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp nodes/Dougs/logo.png nodes/Dougs/Dougs.node.json dist/nodes/Dougs/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DougsLoginApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Dougs/Dougs.node.js"
    ]
  },
  "dependencies": {
    "@plokkke/dougs-compta": "workspace:^"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0"
  }
}
