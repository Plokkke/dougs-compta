{
  "name": "@plokkke/dougs-compta",
  "version": "1.0.1",
  "description": "Unofficial typed client for the Dougs accounting API: validated responses, idempotency-aware retries, integer-cent inputs.",
  "keywords": [
    "dougs",
    "accounting",
    "comptabilite",
    "api-client",
    "sdk"
  ],
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plokkke/dougs-compta.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "fast-check": "^4.3.0",
    "tsup": "^8.5.0"
  }
}
