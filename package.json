{
  "name": "dougs-compta-monorepo",
  "private": true,
  "description": "Unofficial TypeScript toolkit for the Dougs accounting API: SDK, export CLI and n8n node.",
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "mutation": "pnpm --filter @plokkke/dougs-compta mutation",
    "validate": "pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0"
  }
}
